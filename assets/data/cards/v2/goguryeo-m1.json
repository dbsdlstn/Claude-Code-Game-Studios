    {
      "id": "goguryeo-src-01",
      "kind": "source",
      "nation": "goguryeo",
      "title": "동옥저 정복",
      "year": 56,
      "year_alt": [],
      "year_basis": "chronicle",
      "year_note": null,
      "reign_label": "태조왕 4년",
      "source_text": "왕이 동쪽 바닷가의 옥저를 쳐서 그 땅을 빼앗아 고을로 삼았다. 이로써 나라의 경계가 동쪽으로는 큰 바다에, 남쪽으로는 살수에 닿게 되었다.",
      "text_basis": "own_paraphrase_from_original",
