      ]
    },
    {
      "id": "goryeo-src-02",
      "kind": "source",
      "nation": "goryeo",
      "title": "과거 실시",
      "year": 958,
      "year_alt": [],
      "year_basis": "chronicle",
      "year_note": null,
      "reign_label": "광종 9년",
      "source_text": "중국에서 귀화한 신하의 건의에 따라 처음으로 시험을 치러 관리를 뽑았고, 그 신하가 시험을 맡았다.",
      "text_basis": "own_paraphrase_from_original",
      "clues": [
        {
          "level": 1,
          "kind": "relation",
          "relations": [
            {
              "op": "after",
              "ref": "goryeo-reign-taejo"
            },
            {
              "op": "before",
              "ref": "goryeo-reign-seongjong"
            }
          ],
          "text": "[태조]가 즉위한 뒤, [성종]이 즉위하기 전의 일이다."
        },
        {
          "level": 2,
          "kind": "direct",
          "text": "광종 9년(958년). 쌍기, 과거."
        }
      ],
      "answer": {
        "after": "goryeo-reign-gwangjong",
        "before": "goryeo-reign-seongjong"
      },
      "explanation": "광종 9년(958년)의 일. 광종이 쌍기의 건의로 과거를 처음 실시한 일. 쌍기가 지공거를 맡았고 제술업·명경업·잡업으로 나누었다. 공신·호족 대신 시험 출신 관료를 키워 왕권을 강화했다.",
      "exam_tags": [
        "institution",
        "person"
      ],
      "source_ref": {
        "work": "고려사",
        "section": "세가",
        "volume": 2,
        "entry": "광종 9년 5월조",
        "url": null,
        "db_id": null,
        "exam_rounds": [],
        "note": "958년 5월 첫 과거, 쌍기 지공거, 과목 구분은 encykorea·itwiki 요약으로 확인. 쌍기는 956년(광종 7) 후주 사신 설문우를 따라 왔다가 남았고, 건의를 957로 보는 자료가 있다(모두 같은 광종 칸, 고려 b1 대조). 문장은 원문 기사 내용을 근거로 새로 풀어 쓴 것이며 번역문과 기출 문항을 옮기지 않았다. 원문(고려사·고려사절요) 대조 필요. 검증 전(D79·D180·D211)."
      },
