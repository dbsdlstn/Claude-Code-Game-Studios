    {
      "id": "goryeo-src-01",
      "kind": "source",
      "nation": "goryeo",
      "title": "노비안검법",
      "year": 956,
      "year_alt": [],
      "year_basis": "chronicle",
      "year_note": null,
      "reign_label": "광종 7년",
      "source_text": "본래 양인이었다가 억울하게 노비가 된 사람을 조사하여 다시 양인으로 돌려놓게 하였다.",
      "text_basis": "own_paraphrase_from_original",
      "clues": [
        {
          "level": 1,
          "kind": "relation",
          "relations": [
            {
              "op": "after",
              "ref": "goryeo-reign-gwangjong"
            },
            {
              "op": "before",
              "ref": "goryeo-reign-hyeonjong"
            }
          ],
          "text": "[광종]이 즉위한 뒤, [현종]이 즉위하기 전의 일이다."
        },
        {
          "level": 2,
          "kind": "direct",
          "text": "광종 7년(956년). 노비안검법."
        }
      ],
      "answer": {
        "after": "goryeo-reign-gwangjong",
        "before": "goryeo-reign-seongjong"
      },
      "explanation": "광종 7년(956년)의 일. 광종이 노비안검법을 실시한 일. 호족이 거느린 노비를 줄여 호족 세력을 누르고 왕권을 강화하려는 정책이었다.",
      "exam_tags": [
        "institution"
      ],
      "source_ref": {
        "work": "고려사",
        "section": "세가",
        "volume": null,
        "entry": "광종 7년조",
        "url": null,
        "db_id": null,
        "exam_rounds": [],
        "note": "956 노비안검법과 목적은 itwiki 요약으로 확인. 기사가 세가·형법지 중 어디에 있는지는 원문 확인 필요. 기사가 세가가 아니라 형법지(권84~85 무렵)일 가능성(고려 b1 대조, D214). 문장은 원문 기사 내용을 근거로 새로 풀어 쓴 것이며 번역문과 기출 문항을 옮기지 않았다. 원문(고려사·고려사절요) 대조 필요. 검증 전(D79·D180·D211)."
      },
      "disputed": false,
      "disputed_note": null,
