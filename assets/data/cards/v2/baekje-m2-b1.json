    {
      "id": "baekje-src-01",
      "kind": "source",
      "nation": "baekje",
      "title": "평양성 공격",
      "year": 371,
      "year_alt": [],
      "year_basis": "chronicle",
      "year_note": null,
      "reign_label": "근초고왕 26년",
      "source_text": "왕이 태자와 함께 정예 군사 3만을 이끌고 북쪽 이웃 나라의 큰 성을 쳤다. 그 나라 왕이 막아 싸우다 날아온 화살에 맞아 죽었다.",
      "text_basis": "own_paraphrase_from_original",
      "clues": [
        {
          "level": 1,
          "kind": "relation",
          "relations": [
            {
              "op": "after",
              "ref": "baekje-reign-onjo"
            },
            {
              "op": "before",
              "ref": "baekje-reign-chimnyu"
            }
          ],
          "text": "[온조왕]이 즉위한 뒤, [침류왕]이 즉위하기 전의 일이다."
        },
        {
          "level": 2,
          "kind": "direct",
          "text": "근초고왕 26년(371년). 고구려 평양성, 고국원왕 전사."
        }
      ],
      "answer": {
        "after": "baekje-reign-geunchogo",
        "before": "baekje-reign-chimnyu"
      },
      "explanation": "근초고왕 26년(371년)의 일. 근초고왕이 태자 근구수와 함께 고구려 평양성을 공격해 고국원왕을 전사시킨 일. 백제 전성기의 대표 사건이다.",
      "exam_tags": [
        "war"
      ],
      "source_ref": {
        "work": "삼국사기",
        "section": "백제본기",
        "volume": 24,
        "entry": "근초고왕 26년조",
        "url": null,
        "db_id": null,
        "exam_rounds": [],
        "note": "태자 근구수, 정예병 3만, 고국원왕이 화살에 맞아 전사는 한국민족문화대백과 고국원왕 요약으로 확인. 기출: 47회(근초고왕·광개토왕 순서), 70회 정리 자료(검색 요약 기준, 문항 수준 미확인이라 추정 회차). 문장은 원문 기사 내용을 근거로 새로 풀어 쓴 것이며 번역문과 기출 문항을 옮기지 않았다. 원문 대조 필요. 검증 전(D79·D140)."
      },
