      "year_note": null,
      "reign_label": "법흥왕 9년",
      "source_text": "남쪽 가야의 왕이 사신을 보내 혼인을 청하자, 왕이 귀족 집안의 여인을 보내 그 왕의 아내가 되게 하였다.",
      "text_basis": "own_paraphrase_from_original",
      "clues": [
        {
